# Copy to .env for local development. Never commit real secrets.

# --- Application ---
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Dev auth is a local stand-in for Supabase Auth. Refused when NODE_ENV=production.
ALLOW_DEV_AUTH=true
DEV_JWT_SECRET=replace-with-a-long-random-string
DEV_LOGIN_PASSWORD=dev-only-password
SEED_DEMO_DATA=true

# --- Supabase (required for hosted auth, Postgres, and Storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. Never expose this in the web or mobile bundle.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# Storage provider: memory (local demo) or supabase.
STORAGE_PROVIDER=memory
SUPABASE_STORAGE_BUCKET_ORIGINALS=face-originals
SUPABASE_STORAGE_BUCKET_PREVIEWS=face-previews
SUPABASE_STORAGE_BUCKET_EVIDENCE=evidence

# --- Payments ---
# sandbox debits a fake balance. No card is charged. iyzico is used only when keys are set.
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-string
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=http://localhost:4000/api/v1/payments/webhooks/iyzico

# --- Blockchain ---
# Local Hardhat node by default. No user wallet is required.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
# Backend only. Never ship this key to web or mobile clients.

# Cloudflare R2 is intentionally not required.
